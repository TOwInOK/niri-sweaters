#!/bin/sh
set -eu

variant_bin=/usr/local/bin/niri-sweaters
default_config=/usr/local/share/niri-sweaters/default-config.kdl
service=niri-sweaters.service
shutdown=niri-sweaters-shutdown.target
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config="$config_home/niri-sweaters/config.kdl"

if [ ! -e "$config" ] && [ ! -L "$config" ]; then
    mkdir -p "$(dirname -- "$config")"
    if [ -f "$config_home/niri/config.kdl" ]; then
        (
            config_copy=$(mktemp -d "$config_home/.niri-sweaters.XXXXXX")
            trap 'chmod -R u+w -- "$config_copy"; rm -rf -- "$config_copy"' 0
            # Dereference Home Manager links without losing private or executable modes.
            cp -RL --preserve=mode -- "$config_home/niri/." "$config_copy/"
            chmod -R u+w -- "$config_copy"
            cp -R --no-clobber --preserve=mode -- "$config_copy/." "$(dirname -- "$config")/"
        )
    else
        cp --no-clobber --no-preserve=mode -- "$default_config" "$config"
    fi
fi

NIRI_CONFIG=$config
export NIRI_CONFIG

# When systemd starts the service, run the compositor directly instead of
# recursively asking the service manager to start the same unit.
if [ -n "${MANAGERPID:-}" ] && [ "${SYSTEMD_EXEC_PID:-}" = "$$" ]; then
    case "$(ps -p "$MANAGERPID" -o cmd=)" in
    *systemd*--user*)
        exec "$variant_bin" --session
        ;;
    esac
fi

if [ -n "${SHELL:-}" ] &&
   grep -q "$SHELL" /etc/shells &&
   ! (echo "$SHELL" | grep -q "false") &&
   ! (echo "$SHELL" | grep -q "nologin"); then
  if [ "${1:-}" != '-l' ]; then
    exec "$SHELL" -l -c "exec $0 -l $*"
  else
    shift
  fi
fi

if command -v systemctl >/dev/null 2>&1; then
    if systemctl --user -q is-active "$service"; then
      echo 'A Niri Sweaters session is already running.'
      exit 1
    fi

    systemctl --user reset-failed
    systemctl --user import-environment

    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --all
    fi

    systemctl --user --wait start "$service"
    systemctl --user start --job-mode=replace-irreversibly "$shutdown"
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP NIRI_SOCKET NIRI_CONFIG
else
    exec "$variant_bin" --session
fi
